# ==============================================================================
# Lokrun Civic-Infrastructure Platform - Environment Configuration Example
# ==============================================================================

# Server listening port (Render sets this automatically; defaults to 3000 locally)
PORT=3000

# Optional custom administrator password for the seeded lokrun.admin account.
# If set, scrypt-hashes this password for lokrun.admin on server boot.
# Leave blank locally to use the default 'Lokrun@2026'.
ADMIN_PASSWORD=

# Feature flag: Enable or disable new administrator registration (/admin/register.html)
# Default is 'true' locally. Set to 'false' on public hosting to lock admin registration.
LOKRUN_ALLOW_REGISTRATION=true

# Feature flag: Hide default demo login hint on login page (/admin/login.html)
# Default is 'false' locally. Set to 'true' on public hosting to hide credentials hint.
LOKRUN_HIDE_DEMO_HINT=false
